{
  "name": "belair-buvette",
  "private": true,
  "scripts": {
    "build": "pnpm run build:api && pnpm run build:frontend",
    "build:api": "pnpm --dir ./apps/api build",
    "build:frontend": "pnpm --dir ./apps/frontend build",
    "test": "pnpm run test:api && pnpm run test:frontend",
    "test:api": "pnpm --dir ./apps/api test",
    "test:frontend": "pnpm --dir ./apps/frontend test",
    "test:watch:api": "pnpm --dir ./apps/api test:watch",
    "test:watch:frontend": "pnpm --dir ./apps/frontend test:watch",
    "test:coverage:frontend": "pnpm --dir ./apps/frontend test:coverage",
    "lint": "pnpm --dir ./apps/frontend lint",
    "typecheck": "pnpm --dir ./apps/frontend typecheck",
    "storybook": "pnpm --dir ./apps/frontend storybook",
    "build-storybook": "pnpm --dir ./apps/frontend build-storybook",
    "validate:issues": "pnpm run validate:issues:api && pnpm run validate:issues:frontend",
    "validate:issues:api": "pnpm --dir ./apps/api validate:issues",
    "validate:issues:frontend": "pnpm --dir ./apps/frontend validate:issues"
  },
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=9.0.0"
  }
}